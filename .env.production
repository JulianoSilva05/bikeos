# Configurações de Produção - HostGator
# Este arquivo deve ser renomeado para .env no servidor

# === CONFIGURAÇÕES DO BANCO DE DADOS ===
DB_HOST=localhost
DB_NAME=jul33718_bikeos
DB_USER=jul33718_juliano
DB_PASS=Jjmgmz56@
DB_CHARSET=utf8mb4

# === CONFIGURAÇÕES DE EMAIL ===
# Titan Email - BikeOS
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=465
EMAIL_USERNAME=contato@bikeos.com.br
EMAIL_PASSWORD=sua_senha_titan_email_aqui
EMAIL_ENCRYPTION=ssl
EMAIL_FROM_NAME=BikeOS - Sistema de Gestão
EMAIL_FROM_ADDRESS=contato@bikeos.com.br

# === CONFIGURAÇÕES DE SEGURANÇA ===
# Gere uma chave secreta única para produção
SECRET_KEY=sua_chave_secreta_unica_aqui_32_chars
CSRF_TOKEN_NAME=bikeos_csrf_token
SESSION_NAME=bikeos_session

# === CONFIGURAÇÕES DO SISTEMA ===
ENVIRONMENT=production
DEBUG=false
APP_URL=https://bikeos.com.br
APP_NAME=BikeOS

# === CONFIGURAÇÕES DE UPLOAD ===
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# === CONFIGURAÇÕES DE BACKUP ===
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=sua_chave_backup_32_chars_aqui

# === CONFIGURAÇÕES DE LOG ===
LOG_LEVEL=error
LOG_FILE=logs/bikeos.log

# === CONFIGURAÇÕES DE RATE LIMITING ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# === CONFIGURAÇÕES DE CACHE ===
CACHE_ENABLED=true
CACHE_TTL=3600

# === CONFIGURAÇÕES DE TIMEZONE ===
TIMEZONE=America/Sao_Paulo

# === CONFIGURAÇÕES DE MANUTENÇÃO ===
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Sistema em manutenção. Voltaremos em breve.

# === CONFIGURAÇÕES DE NOTIFICAÇÕES ===
NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS=true

# === CONFIGURAÇÕES DE RELATÓRIOS ===
REPORTS_CACHE_ENABLED=true
REPORTS_CACHE_TTL=1800