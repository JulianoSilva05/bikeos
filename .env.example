# Configurações do Banco de Dados
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# Configurações de Segurança
SECURITY_KEY=generate_a_random_32_character_key
CSRF_TOKEN_NAME=csrf_token
SESSION_NAME=bikeos_session

# Configurações de Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Configurações de Log
LOG_LEVEL=INFO
LOG_FILE=error.log
SECURE_LOG_FILE=security.log
AUDIT_LOG_FILE=audit.log
SUSPICIOUS_LOG_FILE=suspicious_activity.log
BLOCKED_IPS_FILE=blocked_ips.json

# Configurações de Monitoramento de Segurança
FAILED_LOGIN_THRESHOLD=5
SUSPICIOUS_REQUESTS_THRESHOLD=10
SECURITY_TIME_WINDOW=300
IP_BLOCK_DURATION=3600

# Configurações de Backup
BACKUP_DIR=backups
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here
MAX_BACKUPS=30
BACKUP_COMPRESSION=gzip
BACKUP_ENCRYPTION_METHOD=AES-256-CBC
BACKUP_SCHEDULE=daily
BACKUP_INCLUDE_UPLOADS=true
BACKUP_EXCLUDE_PATTERNS=logs,cache,temp

# Mercado Pago (Assinaturas) - Access Token da aba Credenciais de produção
MP_ACCESS_TOKEN=
APP_URL=https://bikeos.com.br
